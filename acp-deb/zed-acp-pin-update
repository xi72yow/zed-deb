#!/usr/bin/env bash
set -euo pipefail

# Keeps a pinned copy of the Claude ACP agent for Zed, see acp-deb/README.md
# Usage: zed-acp-pin-update <version|latest|--auto|audit>

PKG="@agentclientprotocol/claude-agent-acp"
TARGET="${ZED_ACP_PIN_DIR:-$HOME/.local/share/zed-acp-pin}"
STAGING="$TARGET.staging"
PREVIOUS="$TARGET.previous"
# replaced at package build time from the node stage of acp-deb/sandbox/Containerfile
IMAGE="@NODE_IMAGE@"
PRESENTATION="node_modules/$PKG/dist/permissions/presentation.js"
MIN_AGE_DAYS="${ZED_ACP_PIN_MIN_AGE_DAYS:-7}"
JOURNAL_HINT="Details: journalctl --user -u zed-acp-pin-update"

# compromised releases tend to be caught within days, so fresh ones are skipped,
# the cutoff then applies to the whole dependency tree via npm install --before
read -r -d '' RESOLVE_JS <<'EOF' || true
const times = JSON.parse(require("fs").readFileSync(0));
const minAgeCutoff = Date.now() - process.env.MIN_AGE_DAYS * 86400000;
const requested = process.env.REQUESTED;
const [version, published] = requested
  ? [requested, times[requested]]
  : Object.entries(times)
      .filter(([v, date]) => /^\d+\.\d+\.\d+$/.test(v) && Date.parse(date) <= minAgeCutoff)
      .sort(([, a], [, b]) => Date.parse(b) - Date.parse(a))[0] ?? [];
if (!published) process.exit(1);
// an explicit version may be younger than the minimum age, its dependencies may then be as fresh as itself
console.log(version, new Date(Math.max(minAgeCutoff, Date.parse(published))).toISOString());
EOF

read -r -d '' AUDIT_JS <<'EOF' || true
const report = JSON.parse(require("fs").readFileSync(0));
if (!report.metadata) process.exit(1);
const { high = 0, critical = 0 } = report.metadata.vulnerabilities;
console.log(high + critical);
EOF

read -r -d '' PERMISSION_TITLE_JS <<EOF || true
import('/app/$PRESENTATION').then(m => {
  const r = m.buildClaudePermissionPresentation({
    toolName: 'Bash',
    toolUseID: 't1',
    input: { command: 'ls -la /tmp', description: 'List files' },
  });
  console.log(r.toolCall.title);
});
EOF

installed_version() {
  local manifest="$TARGET/node_modules/$PKG/package.json"
  [ -f "$manifest" ] || { echo "none"; return; }
  sed -n 's/^ *"version": "\(.*\)",$/\1/p' "$manifest" | head -1
}

# prints "<version> <cutoff>", newest settled release if no version is requested
resolve() {
  podman run --rm -e MIN_AGE_DAYS="$MIN_AGE_DAYS" -e REQUESTED="${1:-}" "$IMAGE" \
    sh -c 'npm view "$1" time --json 2>/dev/null | node -e "$2"' sh "$PKG" "$RESOLVE_JS" </dev/null
}

notify() {
  gdbus call --session \
    --dest org.freedesktop.Notifications \
    --object-path /org/freedesktop/Notifications \
    --method org.freedesktop.Notifications.Notify \
    "zed-acp-pin" 0 "$1" "$2" "$3" "[]" "{}" 0 >/dev/null
}

# security fixes are delayed by the minimum age as well, known advisories surface them earlier
audit_installed() {
  local findings
  [ -f "$TARGET/package-lock.json" ] || { echo "no lockfile in $TARGET, skipping audit"; return; }
  if ! findings=$(podman run --rm -v "$TARGET:/app:ro,Z" -w /app "$IMAGE" \
    sh -c 'npm audit --omit=dev --json | node -e "$1"' sh "$AUDIT_JS" </dev/null); then
    notify "dialog-error" "Zed ACP pin: audit failed" "$JOURNAL_HINT"
    return 1
  fi
  echo "audit: $findings high or critical advisories"
  if [ "$findings" -gt 0 ]; then
    notify "dialog-warning" "Zed ACP pin: $findings high or critical advisories in $(installed_version)" \
      "Fixes younger than $MIN_AGE_DAYS days: ZED_ACP_PIN_MIN_AGE_DAYS=0 zed-acp-pin-update latest. $JOURNAL_HINT"
  fi
}

auto_update() {
  local installed settled
  installed=$(installed_version)
  if ! settled=$(resolve); then
    notify "dialog-error" "Zed ACP pin: update check failed" "Staying on $installed. $JOURNAL_HINT"
    exit 1
  fi
  settled="${settled%% *}"
  if [ "$installed" = "$settled" ]; then
    echo "up to date: $installed"
    audit_installed
    return
  fi

  # a function call in this condition would run with set -e disabled
  if ! "${BASH_SOURCE[0]}" "$settled"; then
    notify "dialog-error" "Zed ACP pin: update to $settled failed" "Staying on $installed. $JOURNAL_HINT"
    exit 1
  fi
  notify "software-update-available" "Zed ACP pin: $installed → $settled" \
    "Installed, active after restarting Zed. Previous version: $PREVIOUS"
  audit_installed
}

install_version() {
  local resolved version cutoff
  if ! resolved=$(resolve "${1:-}"); then
    echo "no matching release of $PKG found${1:+ for '$1'}, $TARGET unchanged" >&2
    exit 1
  fi
  read -r version cutoff <<<"$resolved"

  echo "==> installing $PKG@$version into $STAGING, dependency tree as of $cutoff"
  rm -rf "$STAGING"
  mkdir -p "$STAGING"
  podman run --rm -v "$STAGING:/app:Z" -w /app "$IMAGE" sh -c \
    'npm install --save-exact --ignore-scripts --no-fund --no-audit --before="$2" "$1" && npm audit signatures' \
    sh "$PKG@$version" "$cutoff" </dev/null

  echo "==> verifying permission title"
  local title
  title=$(podman run --rm -v "$STAGING:/app:Z" -w /app "$IMAGE" node -e "$PERMISSION_TITLE_JS" </dev/null)
  if [ "$title" != "ls -la /tmp" ]; then
    echo "verification failed, title is '$title', expected the command, $TARGET unchanged" >&2
    exit 1
  fi

  rm -rf "$PREVIOUS"
  if [ -d "$TARGET" ]; then mv "$TARGET" "$PREVIOUS"; fi
  mv "$STAGING" "$TARGET"

  echo "==> ok, $PKG@$(installed_version) shows the command in the permission card"
  echo "previous version kept in $PREVIOUS, restart zed to pick up the new one"
}

case "${1:-}" in
  "")
    cat <<EOF
usage: $(basename "$0") <version|latest|--auto|audit>

installed: $(installed_version)
latest:    newest stable release older than $MIN_AGE_DAYS days, dependencies as of that cutoff
--auto:    installs latest if it differs and audits, reports via desktop notification
audit:     checks the installed tree for high or critical advisories
<version>: installs exactly this version, if younger than the minimum age with dependencies as of its release
EOF
    ;;
  --auto) auto_update ;;
  audit) audit_installed ;;
  latest) install_version ;;
  *) install_version "$1" ;;
esac
